{
  "name": "Clearhead: Getting Things Done",
  "short_name": "Clearhead",
  "description": "Personal GTD system: capture, clarify, organise, review, engage.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f5",
  "theme_color": "#2f6f5e",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Quick capture", "short_name": "Capture", "url": "./?capture=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Process inbox", "short_name": "Process", "url": "./?process=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
